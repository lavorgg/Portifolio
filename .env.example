# Senha do painel /admin: no mínimo 12 caracteres (prefira 16+ gerados por um gerenciador de senhas)
ADMIN_PASSWORD=
# Texto aleatório com 32+ caracteres usado para assinar o login (gere com `openssl rand -hex 32`)
SESSION_SECRET=

# Tentativas de login por IP antes do bloqueio, e por quantos minutos o bloqueio dura
LOGIN_MAX_ATTEMPTS=3
LOGIN_WINDOW_MINUTES=15

# Supabase — deixe em branco para usar o modo local (arquivos em /data)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media
